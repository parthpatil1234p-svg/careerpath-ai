PORT=5000
NODE_ENV=development
SERVER_ROLE=unified # unified (local), realtime-worker (Render), or serverless (Vercel)
# Database Engine: 100% Pure Supabase PostgreSQL via Prisma (0% MongoDB)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5500
PROD_CLIENT_URL=https://careerpath-ai.vercel.app

# Optional AI Providers (Dual-Engine Fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional Third-Party Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
YOUTUBE_API_KEY=

# Supabase PostgreSQL Database & API Configuration
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
