        {
          "name": "Get Current Active Roadmap",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.tasks && json.data.tasks.length > 0) {",
                  "        var firstTaskId = json.data.tasks[0]._id || json.data.tasks[0].id;",
                  "        pm.collectionVariables.set('taskId', firstTaskId);",
                  "        console.log('Saved first task id to {{taskId}}: ' + firstTaskId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
